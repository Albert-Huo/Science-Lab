# 复制为 .env 并按实际填写。切勿提交 .env 到仓库。

# 监听端口（nginx 反代到此端口；不要直接对公网暴露）
PORT=8970

# JWT 签名密钥：用一段长随机字符串。生成示例：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为长随机字符串
# 登录态有效期
JWT_EXPIRES=30d

# 允许调用接口的前端来源（逗号分隔，需与实际访问地址完全一致，含协议）
CORS_ORIGINS=https://lab.xingnian.net.cn,https://albert-huo.github.io,https://html.xingnian.net.cn,http://127.0.0.1:8788

# DeepSeek 服务端代理（缺失时服务仍可启动，但 /ai/* 返回 503）
DEEPSEEK_API_KEY=
# AI 接口按真实客户端 IP 的调用上限
AI_RATE_LIMIT_MINUTE_MAX=10
AI_RATE_LIMIT_DAY_MAX=20
# DeepSeek 单次请求总超时（毫秒）
AI_UPSTREAM_TIMEOUT_MS=120000

# MySQL 连接（建议为本应用单独建库与账号）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sciencelab
DB_PASSWORD=请填写数据库密码
DB_NAME=sciencelab
