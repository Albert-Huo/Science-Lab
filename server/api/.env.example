# 复制为 .env 并按实际填写。切勿提交 .env 到仓库。

# 运行模式：full 保留账号/同步；ai-only 只提供健康检查与 AI，不加载数据库、不要求 JWT。
# 未设置或留空时默认 full；其他非空值会拒绝启动。本站免登录部署请改为 ai-only。
APP_MODE=full
# 生产部署必须设置 production；会强制要求 Redis 共享额度和稳定的会话签名密钥。
NODE_ENV=production

# 监听端口（nginx 反代到此端口；不要直接对公网暴露）
PORT=8970

# 仅 full 必需。JWT 签名密钥：用一段长随机字符串。生成示例：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为长随机字符串
# 登录态有效期
JWT_EXPIRES=30d

# 允许调用接口的前端来源（逗号分隔，需与实际访问地址完全一致，含协议）
CORS_ORIGINS=https://lab.xingnian.net.cn,https://albert-huo.github.io,https://html.xingnian.net.cn,http://127.0.0.1:8788

# DeepSeek 服务端代理（缺失时服务仍可启动，但 /ai/* 返回 503）
DEEPSEEK_API_KEY=
# 实际模型 ID；界面统一显示 DeepSeek，默认使用 Flash 模型
DEEPSEEK_MODEL=deepseek-v4-flash
# AI 接口按真实客户端 IP 的调用上限
AI_RATE_LIMIT_MINUTE_MAX=10
AI_RATE_LIMIT_DAY_MAX=20
# 匿名会话与全站请求额度，均为首次使用起24小时窗口（非每日零点）。
# 学校共用IP可将 AI_RATE_LIMIT_DAY_MAX 调至200，但保留会话与全站上限。
AI_SESSION_DAY_MAX=20
AI_GLOBAL_DAY_MAX=500
AI_GLOBAL_CONCURRENT_MAX=5
# 用私密环境配置提供至少32字符随机密钥，不得使用JWT密钥或DeepSeek Key。
AI_SESSION_SECRET=
# Redis 必须使用持久化与 noeviction；不要把含密码的URL粘贴进日志/命令行。
AI_REDIS_URL=redis://127.0.0.1:6379/0
# DeepSeek 单次请求总超时（毫秒）
AI_UPSTREAM_TIMEOUT_MS=120000

# 仅 full 必需。MySQL 连接（建议为本应用单独建库与账号）
# DB_DRIVER=memory 仅供本地自测，不持久化，不能作为生产免数据库方案。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sciencelab
DB_PASSWORD=请填写数据库密码
DB_NAME=sciencelab
