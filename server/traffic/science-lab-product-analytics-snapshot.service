[Unit]
Description=Publish Science Lab identity-free product analytics snapshot
After=network.target science-lab-analytics-redis.service
Wants=science-lab-analytics-redis.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/science-lab-analytics.env
Environment=SCIENCE_LAB_API_DIR=/opt/science-lab-api-current
ExecStart=/opt/science-lab-runtime/node-v22.23.2-linux-x64/bin/node /opt/science-lab-traffic/product-analytics-snapshot.cjs --state-dir /var/lib/science-lab-traffic
TimeoutStartSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=false
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/science-lab-traffic/www
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryMax=96M
TasksMax=32
Nice=10
